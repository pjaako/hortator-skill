# Private. Copy to ~/.config/hortator/site.env and fill in. Read by scripts/dispatch_local.sh.
# Command that starts the local model server; "{preset}" is replaced by the preset name.
HORTATOR_MODEL_START="/path/to/switch-model.sh {preset}"
# Command that stops it.
HORTATOR_MODEL_STOP="/path/to/switch-model.sh stop"
# Health endpoint that returns HTTP 200 when the model is loaded.
HORTATOR_MODEL_HEALTH="http://127.0.0.1:8080/health"
# System prompt for the coder agent.
HORTATOR_CODER_PROMPT="/path/to/coder.md"
# opencode provider/model as configured in your opencode.json.
HORTATOR_OPENCODE_MODEL="llamacpp/local"
# Directory that contains the opencode binary.
HORTATOR_OPENCODE_BIN="$HOME/.opencode/bin"
